CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Do NOT set DATABASE_URL for local development. config/database.yml already
# selects the right database per environment (…_development vs …_test) over a
# local Postgres. A global DATABASE_URL overrides database.yml and forces the
# test suite onto your development database. DATABASE_URL is set only in
# production (Render → Supabase).
