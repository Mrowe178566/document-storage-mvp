CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Don't set DATABASE_URL locally. config/database.yml gives development and test
# their own databases; a DATABASE_URL would override that and run the test suite
# against your development data. It is only set in production.
