// File Vault dev container — runs the app + Postgres in Codespaces.
// Format reference: https://aka.ms/devcontainer.json
{
  "name": "File Vault",
  "dockerComposeFile": "docker-compose.yml",
  "service": "devcontainer",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "containerEnv": {
    "PGHOST": "localhost",
    "PGUSER": "postgres",
    "PGPASSWORD": "postgres",
    "PGDATABASE": "document_storage_mvp_development"
  },
  // NOTE: deliberately no DATABASE_URL here. The PG* vars above tell Postgres
  // how to connect, and config/database.yml selects the right database per
  // environment (…_development vs …_test). A global DATABASE_URL would override
  // database.yml and force the test suite onto the development database.

  "forwardPorts": [3000],

  "portsAttributes": {
    "3000": {
      "label": "Rails server",
      "onAutoForward": "silent"
    }
  },

  "otherPortsAttributes": { "onAutoForward": "ignore" },

  "postCreateCommand": "bin/setup",

  "customizations": {
    "vscode": {
      "extensions": [
        "vortizhe.simple-ruby-erb",
        "aliariff.vscode-erb-beautify",
        "eamodio.gitlens",
        "setobiralo.erb-commenter"
      ]
    }
  }
}
